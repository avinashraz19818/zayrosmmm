# Telegram API credentials: https://my.telegram.org
API_ID=123456
API_HASH=replace_with_telegram_api_hash

# BotFather token
BOT_TOKEN=replace_with_bot_token

# MongoDB Atlas SRV URI. Use a least-privilege database user.
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/?retryWrites=true&w=majority&appName=tg-manager
MONGO_DB_NAME=tg_manager_bot
MONGO_GRIDFS_BUCKET=tg_manager_storage

# Comma-separated Telegram user IDs allowed as owners.
OWNER_IDS=123456789

# Optional; the app uses /tmp automatically on Heroku.
# RUNTIME_DIR=/tmp/tg-manager
# STORAGE_SYNC_INTERVAL=120

# Account worker sharding on Heroku. One worker owns at most 10 sessions.
ACCOUNT_SHARDING=true
ACCOUNT_SHARD_SIZE=10
WORKER_RECONCILE_INTERVAL=60
# Set these only if automatic Heroku worker scaling is wanted.
# HEROKU_APP_NAME=your-heroku-app-name
# HEROKU_API_KEY=your-heroku-platform-api-key
